{
  "name": "fusionitos",
  "private": true,
  "version": "0.1.0",
  "description": "Juego web merge idle: fusioná criaturas, descubrí las 120 y subí por los 20 pisos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators --port 5174 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "design:tables": "node scripts/design-tables.ts",
    "simulate": "node scripts/simulate.ts",
    "emulators": "npx -y firebase-tools@15.34.0 emulators:start --only auth,firestore --project demo-fusionitos"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "firebase": "13.1.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
