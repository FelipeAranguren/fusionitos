rules_version = '2';
// Reglas de Firestore: cuando cambien, hay que publicarlas también en la consola de Firebase (pestaña Reglas).
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada jugador lee y guarda solo su propia partida.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 'session'])
        && request.resource.data.save is string
        && request.resource.data.save.size() < 500000
        && request.resource.data.session is string
        && request.resource.data.session.size() <= 64;
    }
  }
}
